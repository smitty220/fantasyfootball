# Yahoo Fantasy API client ID (OAuth2 app credentials)
YAHOO_CLIENT_ID=
# Yahoo Fantasy API client secret (OAuth2 app credentials)
YAHOO_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the Yahoo developer app
YAHOO_REDIRECT_URI=https://localhost:8000/api/auth/yahoo/callback
# FantasyPros API key for player rankings/projections
FANTASYPROS_API_KEY=

# Full-access password. Leave empty to disable the login screen entirely
OWNER_PASSWORD=
# Read-only password for league mates; ignored unless OWNER_PASSWORD is set
LEAGUE_PASSWORD=
# Random string signing the session cookie; regenerating it logs everyone out
SESSION_SECRET=
